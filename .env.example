# Docker deployment configuration (copy to .env)
# The image is built locally by `docker compose build`; there is no registry tag.
# Address the web UI is published on. 127.0.0.1 keeps it host-local; set 0.0.0.0
# to reach it from another machine or from Windows when ARTEX runs inside WSL.
ARTEX_BIND_ADDR=127.0.0.1
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Login. 0 = no password, console opens straight onto the launcher (default).
# 1 = the old password login. While it is 0, the API is only served to peers in
# ARTEX_NOAUTH_CIDRS, so keep ARTEX_BIND_ADDR on loopback.
ARTEX_REQUIRE_AUTH=0
ARTEX_NOAUTH_CIDRS=127.0.0.0/8,::1/128

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Non-web capability runner (optional `nonweb` compose profile).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RUNNER_TOKEN=
# Generate with: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# RUNNER_SCOPE_KEY and ARTEX_SCOPE_KEY must be the same 32-byte base64 value.
RUNNER_SCOPE_KEY=
ARTEX_SCOPE_KEY=
# Path inside the ARTEX container; the host ./data/scopes directory is mounted
# read-only into the runner at /scopes.
ARTEX_SCOPE_DIR=/app/data/scopes
